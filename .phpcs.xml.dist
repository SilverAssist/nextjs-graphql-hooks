<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="NextJS GraphQL Hooks" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd">
    <description>Uses the shared SilverAssistWP ruleset from silverassist/wp-coding-standards.</description>

    <!-- Show progress and sniff codes in all reports -->
    <arg value="ps"/>

    <!-- Enables parallel processing when available for faster results. -->
    <arg name="parallel" value="8"/>

    <!-- Limit to PHP files only -->
    <arg name="extensions" value="php"/>

    <rule ref="SilverAssistWP"/>

    <!-- Include directories to scan -->
    <file>.</file>

    <!-- Exclude directories and files -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>.git/*</exclude-pattern>
    <exclude-pattern>*.js</exclude-pattern>
    <exclude-pattern>*.css</exclude-pattern>
    <exclude-pattern>*.md</exclude-pattern>

    <!-- Overrides SilverAssistWP's default testVersion (8.2-): this plugin
         declares and is distributed for PHP 8.0+ (see composer.json and
         the plugin header). Note CI's quality-checks.yml matrix currently
         only actually tests PHP 8.3, so this floor isn't continuously
         verified in practice; worth a follow-up, out of scope here. -->
    <config name="testVersion" value="8.0-"/>
</ruleset>
